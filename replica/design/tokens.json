{
  "_about": "Bit Bot Grok 缺口设计 token（replica-design 产出）。命名严格对齐 docs/design/desktop-target/ui-unified-spec.md §2 单一源：颜色/类型阶/间距/圆角/阴影/动效全部复用同一套语义名，缺口侧仅新增 --code-bg 一个角色（markdown 代码块底色）。对比校验：python3 contrast.py replica/design/tokens.json",
  "color": {
    "bg": "#f5f5f7",
    "bg-elev": "#ffffff",
    "text": "#1a1a1a",
    "text-muted": "#6b6b6b",
    "border": "#e6e6e9",
    "fill": "#f4f4f5",
    "fill-strong": "#ebebee",
    "accent": "#1a1a1a",
    "accent-ink": "#ffffff",
    "danger": "#c62f2f",
    "success": "#1f7a4d",
    "code-bg": "#f6f8fa"
  },
  "pairs": [
    ["text", "bg"],
    ["text", "bg-elev"],
    ["text-muted", "bg"],
    ["text-muted", "bg-elev"],
    ["accent-ink", "accent"],
    ["accent", "bg"],
    ["danger", "bg"],
    ["success", "bg"],
    ["text", "code-bg"],
    ["text-muted", "code-bg"]
  ],
  "font": {
    "sans": "-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif",
    "mono": "ui-monospace, \"SF Mono\", Menlo, monospace"
  },
  "type": {
    "fs-caption": {"size": 13, "line": 18, "weight": 500},
    "fs-body": {"size": 14, "line": 21, "weight": 400},
    "fs-card-title": {"size": 15, "line": 21, "weight": 600},
    "fs-display": {"size": 21, "line": 26, "weight": 600}
  },
  "space": [0, 4, 8, 12, 16, 20, 24, 32],
  "radius": {"r-control": 10, "r-card": 12, "r-sheet": 16, "r-pill": 999},
  "shadow": {
    "card": "0 1px 2px rgba(16,24,40,.06), 0 1px 3px rgba(16,24,40,.10)",
    "sheet": "0 24px 64px rgba(0,0,0,.18)"
  },
  "motion": {"fast": "150ms", "base": "200ms", "ease": "cubic-bezier(.2,.8,.2,1)"}
}
