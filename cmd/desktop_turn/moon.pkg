import {
  "bitbot/bitbot",
  "bitbot/bitbot/agents/cloud",
  "bitbot/bitbot/agents/computer_use",
  "bitbot/bitbot/agents/task",
  "bitbot/bitbot/agents/teammates",
  "bitbot/bitbot/box_host",
  "bitbot/bitbot/channels",
  "bitbot/bitbot/connectors",
  "bitbot/bitbot/connectors/commerce",
  "bitbot/bitbot/connectors/mail",
  "bitbot/bitbot/memory",
  "bitbot/bitbot/routines",
  "bitbot/bitbot/runtime",
  "bitbot/bitbot/security",
  "bitbot/bitbot/skills",
  "bitbot/bitbot/tools",
  "bitbot/bitbot/ui_protocol",
  "moonbitlang/core/env",
}

pkgtype(kind: "executable")

options(
  targets: {
    "agent_loop_product_native.mbt": [ "native", "llvm" ],
    "agent_loop_product_wasm.mbt": [ "wasm", "wasm-gc" ],
  },
  "native-stub": [ "bitbot_ffi_stub.c" ],
)
