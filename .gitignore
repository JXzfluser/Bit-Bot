.DS_Store
_build/
target/
target
.mooncakes/
.moonagent/
# Python bytecode (build cache)
__pycache__/
*.pyc
# Never commit browser profile DBs captured by Host smoke
docs/qa/artifacts/**/Cookies*
docs/qa/artifacts/**/Login Data*
docs/qa/artifacts/**/Web Data*
docs/qa/artifacts/**/History*

# H4 smoke live Host FS paths (evidence copies live under docs/qa/artifacts/)
h4-mcp-big-body.txt
agent-tools/

# Product Host runtime durable state (dirs created by start/deploy)
/data/**/*.json
/data/**/*.jsonl
/data/**/*.ics
/data/**/*.eml
# data/routines/bitbot-routine-daemon.service 是 scripts/host_routine_daemon.sh 用 sed
# 从 scripts/*.example 生成的本机路径产物（WorkingDirectory/ExecStart 里是绝对路径）。
# 跟踪它 = 每台跑过守护的机器都会把别人的绝对路径带进 diff，所以按生成物处理。
/data/routines/*.service
/data/**/*.html
*.bitbot-plan.md
*.bitbot-applied.json
/data/voice/media/
/data/secrets/
/data/host/turn-token
# K-1/K-3: the agent context is conversation state, not source.
/data/agent-context/
/data/traces/
/data/desktop/frames/
!/data/**/.gitkeep
/data/journal/computer-use/
/tmp/bitbot-sandbox/

# Desktop (Electron)
/hosts/desktop/node_modules/
/hosts/desktop/dist/
/hosts/desktop/out/
# 内核二进制是 scripts/pack-desktop.sh 打包时 stage 出来的产物（~2MB Mach-O/PE），
# 不是源码；进版本库会让每次改内核都变成一次大二进制提交。
/hosts/desktop/resources/kernel/
# Mobile pack staging (scripts/pack-mobile.sh)
/hosts/dist/
# Host MCP temp request/response files
/data/tmp/
/desktop/node_modules/
/desktop/dist/
/desktop/out/
# Accidental root npm init (Desktop lives under hosts/desktop/)
/package.json
/package-lock.json
/node_modules/

/uploads/
data/voice/
h3-cross-agent-shared.txt

.env.local
**/.env.local
/tools/cloudflared

# WorkBuddy session data & local caches
.workbuddy/
.electron_cache/
.bitbot_sandbox/

# voice temp recordings
data/desktop/voice/

# D-ST computed-style snapshot (regenerated by scripts/e2e_modal_computed.mjs)
docs/design/desktop-target/reference/modal-computed.json

# 用户旅程门禁证据（截图 + provider 请求记录），不入仓
/artifacts/

# 聊天附件落盘目录（按会话 id 生成，属运行时数据，不入仓）
/data/workspace/uploads/
