{
  "name": "bitbot-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Bit Bot Desktop host — MoonBit product brain via Electron",
  "author": "Bit Bot",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.bitbot.desktop",
    "productName": "Bit Bot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "sessions.js",
      {
        "from": "../shared",
        "to": "shared",
        "filter": ["**/*"]
      }
    ],
    "asar": true,
    "afterSign": "build/notarize.js",
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.bitbot.local/desktop"
      }
    ],
    "linux": {
      "target": ["AppImage", "dir"],
      "category": "Utility"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "win": {
      "target": ["nsis"],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
