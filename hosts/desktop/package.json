{
  "name": "bitbot-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Bit Bot Desktop host — MoonBit product brain via Electron",
  "author": "Bit Bot",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.bitbot.desktop",
    "productName": "Bit Bot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      {
        "from": ".",
        "to": "desktop",
        "filter": [
          "main.js",
          "preload.js",
          "index.html",
          "ui_chrome.css",
          "vendor/**/*",
          "sessions.js",
          "paths.js",
          "product_surface.js",
          "room_orchestrator.js",
          "progress_protocol.js",
          "secret_protocol.js",
          "secret_vault.js",
          "link_open.js",
          "link_discipline.js",
          "build/icon.png",
          "!**/*.map",
          "!**/LICENSES.chromium.html"
        ]
      },
      {
        "from": "../shared",
        "to": "shared",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      }
    ],
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "asar": true,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "compression": "maximum",
    "afterPack": "build/afterPack.js",
    "extraResources": [
      {
        "from": "resources/kernel",
        "to": "kernel",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterSign": "build/notarize.js",
    "publish": [
      {
        "provider": "github",
        "owner": "JXzfluser",
        "repo": "Bit-Bot"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Utility",
      "icon": "build/icons"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "win": {
      "target": [
        "zip",
        "dir"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "Bit Bot Setup ${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.49.1"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
