{
  "name": "bitbot-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Bit Bot Desktop host — MoonBit product brain via Electron",
  "author": "Bit Bot",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.bitbot.desktop",
    "productName": "Bit Bot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "sessions.js",
      {
        "from": "../shared",
        "to": "shared",
        "filter": ["**/*"]
      }
    ],
    "asar": true,
    "linux": {
      "target": ["dir"],
      "category": "Utility"
    },
    "mac": {
      "target": ["dir"],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": ["dir"],
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
