# Open configuration — never hardcode keys in the repo or installer.
# Copy to hosts/desktop/.env.local (gitignored), OR use Desktop
# 「凭证」/ Settings →「产品凭证」保存并热加载（无需重启）.
# Desktop-first product brain (iOS/Android deferred this phase).

BITBOT_LLM_API_KEY=
BITBOT_LLM_BASE_URL=https://api.deepseek.com/v1
BITBOT_LLM_MODEL=deepseek-chat
# BITBOT_LLM_PROVIDER=deepseek
# Optional multi-model keys (also via Settings if you extend the form):
# BITBOT_LLM_QWEN_API_KEY=
# BITBOT_LLM_MOONSHOT_API_KEY=

# Optional CN channel live gates (draft unless POST=1 + credential)
# BITBOT_DINGTALK_POST=1
# BITBOT_DINGTALK_WEBHOOK=
# BITBOT_DINGTALK_TOKEN=
# BITBOT_FEISHU_POST=1
# BITBOT_FEISHU_TOKEN=
# BITBOT_FEISHU_CHAT_ID=
# BITBOT_WECOM_POST=1
# BITBOT_WECOM_TOKEN=
# BITBOT_WECOM_AGENT_ID=
# BITBOT_WECOM_TOUSER=

# P4 filing / moderation / OTA (optional; residual if unset)
# BITBOT_ICP_FILING=
# BITBOT_ALGORITHM_FILING=
# Content moderation defaults ON in Desktop if unset; set 0 to disable.
BITBOT_CONTENT_MODERATION=1
# BITBOT_UPDATE_FEED_URL=
