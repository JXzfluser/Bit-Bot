<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- CM-0705: Host declares dangerous permissions; never pretend-granted without OS dialog. -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- 局域网扫描第一步是问 ConnectivityManager「我现在挂在哪个网上、这个网的 IPv4 是多少」；
       getActiveNetwork / getNetworkCapabilities / getLinkProperties 都要求 ACCESS_NETWORK_STATE，
       没声明就是 ConnectivityService 抛 SecurityException（Neither user nor current process has …）。
       这是 normal 权限，装上即授予，不弹框。 -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <application
    android:allowBackup="true"
    android:label="Bit Bot"
    android:supportsRtl="true"
    android:usesCleartextTraffic="true"
    android:theme="@style/Theme.BitBot">
    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
