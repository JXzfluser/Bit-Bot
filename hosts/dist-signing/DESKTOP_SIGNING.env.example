# Desktop Electron signing env scaffold (copy locally — never commit secrets).
# electron-builder reads these; store submit remains open until certs are present.

# macOS code sign + notarize
CSC_LINK=
CSC_KEY_PASSWORD=
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# Windows Authenticode
CSC_LINK_WIN=
CSC_KEY_PASSWORD_WIN=

# Linux: unsigned AppImage/dir is the default smoke path (see pack-desktop.sh).
BITBOT_DESKTOP_SIGN=0
