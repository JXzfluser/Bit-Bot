# Mobile store signing env scaffold (copy to SIGNING.env locally — never commit secrets).
# App Store / Play submit remains open until certificates/keystores are present.

# iOS
BITBOT_IOS_TEAM_ID=
BITBOT_IOS_BUNDLE_ID=com.bitbot.host

# Android upload keystore
BITBOT_ANDROID_STORE_FILE=
BITBOT_ANDROID_STORE_PASSWORD=
BITBOT_ANDROID_KEY_ALIAS=bitbot
BITBOT_ANDROID_KEY_PASSWORD=
