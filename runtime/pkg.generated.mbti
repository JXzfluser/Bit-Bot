pub fn TranscriptStore::record_tool_call(Self, TranscriptScope, agent_id~ : String, tool_name~ : String, args_json~ : String, result_snippet~ : String) -> Unit

pub(all) struct TurnContext {
  turn_id : @core.TurnId
  session_id : @core.SessionId
  user_id : @core.UserId
  phase : TurnPhase
  timezone : @core.TimeZone
  inbound_kind : InboundKind
  inbound_text : String
  todos : Array[TodoItem]
  outbound : Array[@ui_protocol.SendEnvelope]
} derive(Eq, @debug.Debug)
pub fn TurnContext::acknowledge(Self, body~ : String) -> Self
pub fn TurnContext::allows_tools(Self) -> Bool
pub fn TurnContext::deliver_attachment(Self, name~ : String, mime~ : String, path~ : String) -> Result[Self, String]
pub fn TurnContext::deliver_confirm_then(Self, confirm~ : String, follow_up~ : String) -> Result[Self, String]
pub fn TurnContext::deliver_text(Self, body~ : String, channel_hint? : String?) -> Result[Self, String]
pub fn TurnContext::deliver_text_to_inbound(Self, body~ : String, inbound_address~ : String) -> Result[Self, String]
pub fn TurnContext::deliver_voice_memo(Self, spoken_text~ : String, audio_path? : String) -> Result[(Self, VoiceMemoDelivery), String]
pub fn TurnContext::deliver_widget(Self, widget_id~ : String, spec~ : @ui_protocol.WidgetSpec) -> Result[Self, String]
pub fn TurnContext::done_todo_count(Self) -> Int32
pub fn TurnContext::end_turn(Self) -> Self
pub fn TurnContext::equal(Self, Self) -> Bool
pub fn TurnContext::finalize_text(Self, body~ : String) -> Result[Self, String]
pub fn TurnContext::first_delivered(Self) -> DeliveredMessage?
pub fn TurnContext::ingest_tool_result(Self, tool_id~ : String, body~ : String) -> Self
pub fn TurnContext::is_silent_before_voice_memo(Self) -> Bool
pub fn TurnContext::mark_todo_done(Self, id~ : String) -> Result[Self, String]
pub fn TurnContext::milestone(Self, body~ : String) -> Result[Self, String]
pub fn TurnContext::new(String, String) -> Self
pub fn TurnContext::not_equal(Self, Self) -> Bool
pub fn TurnContext::reply_to_channel_target(Self, body~ : String, inbound_address~ : String?) -> Result[Self, String]
pub fn TurnContext::should_ack_user(Self) -> Bool
pub fn TurnContext::to_repr(Self) -> @debug.Repr
pub fn TurnContext::todo_write(Self, Array[TodoItem]) -> Result[Self, String]
pub fn TurnContext::visible_todos(Self) -> Array[TodoItem]
pub fn TurnContext::voice_memo_count(Self) -> Int32

pub(all) enum TurnPhase {
  Opened
  Acknowledged
  Working
  Milestone
  Finalizing
  Ended
} derive(Eq, @debug.Debug)
pub fn TurnPhase::equal(Self, Self) -> Bool
pub fn TurnPhase::not_equal(Self, Self) -> Bool
pub fn TurnPhase::to_repr(Self) -> @debug.Repr

pub(all) struct VoiceMemoDelivery {
  turn_id : String
  spoken_text : String
  voice_memo : Bool
} derive(Eq, @debug.Debug)
pub fn VoiceMemoDelivery::equal(Self, Self) -> Bool
pub fn VoiceMemoDelivery::not_equal(Self, Self) -> Bool
pub fn VoiceMemoDelivery::to_repr(Self) -> @debug.Repr

